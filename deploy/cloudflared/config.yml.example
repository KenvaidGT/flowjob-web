# Cloudflare Tunnel config example.
# Copy this file to `deploy/cloudflared/config.yml` on the server and fill values.

# Either tunnel UUID or tunnel name (depending on how you created it).
tunnel: flowjob

# Path inside the cloudflared container.
credentials-file: /etc/cloudflared/credentials.json

ingress:
  - hostname: flowjob.id.lv
    service: http://web:80
  - service: http_status:404

